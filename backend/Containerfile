# Womb Atlas Simple — backend build/run container
# Rationale: keeps every backend build identical regardless of host OS
# (no MSVC Build Tools, no Windows SDK, no mingw quirks on Windows).
# Build:  podman build -t womb-atlas-backend ./backend
# Run:    see the `backend` service in ../compose.yaml

FROM docker.io/library/rust:1-slim AS build
WORKDIR /app

# --- dependency cache layer ---------------------------------------------
# Dummy sources let cargo compile the dependency graph once; the layer only
# invalidates when Cargo.toml / Cargo.lock change.
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'fn main() {}' > src/seed.rs && \
    echo 'fn main() {}' > src/migrate.rs && \
    cargo build --release --bins

# --- real build ----------------------------------------------------------
COPY src ./src
RUN touch src/main.rs src/seed.rs src/migrate.rs && \
    cargo build --release --bins

# --- runtime -------------------------------------------------------------
FROM docker.io/library/debian:bookworm-slim
WORKDIR /app
COPY --from=build /app/target/release/womb-atlas-backend /app/
COPY --from=build /app/target/release/seed              /app/
COPY --from=build /app/target/release/migrate           /app/
EXPOSE 4001
# .env is intentionally NOT baked in — configuration arrives via env vars
# (DATABASE_URL, PORT, ALLOWED_ORIGIN) or bind-mounted .env in dev.
CMD ["/app/womb-atlas-backend"]
