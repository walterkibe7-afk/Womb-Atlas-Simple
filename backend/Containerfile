FROM docker.io/library/rust:1-slim AS build
WORKDIR /app
COPY Cargo.toml ./
RUN mkdir -p src && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'fn main() {}' > src/seed.rs && \
    echo 'fn main() {}' > src/migrate.rs && \
    cargo build --release --bins
COPY src ./src
COPY migrations ./migrations
RUN touch src/main.rs src/seed.rs src/migrate.rs && \
    cargo build --release --bins

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/target/release/womb-atlas-backend /app/womb-atlas-backend
EXPOSE 4001
CMD ["/app/womb-atlas-backend"]